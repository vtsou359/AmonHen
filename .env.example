# ---------------------------------------------------------------------------
# Amon Hen configuration
#
# Copy to `.env`. Every value here is optional — the platform starts and is
# usable with none of them set. Keys upgrade it from demo data to live feeds.
# ---------------------------------------------------------------------------

# NASA FIRMS active fire detections.
# Free, issued instantly: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without this the platform serves bundled fixtures and shows a banner saying so.
AMONHEN_FIRMS_MAP_KEY=

# Copernicus Data Space (Sentinel-2/3). NOT currently needed: Sentinel-2 imagery
# comes from the keyless AWS mirror. Kept for the day we need bulk download.
# Register free: https://dataspace.copernicus.eu
AMONHEN_CDSE_CLIENT_ID=
AMONHEN_CDSE_CLIENT_SECRET=

# --- Sentinel-2 imagery ----------------------------------------------------
# Burned-area mapping (dNBR) and live fuel moisture (NDMI). No key needed — the
# imagery comes from the public AWS mirror of Copernicus Sentinel-2 L2A. What it
# does need is `rasterio`, which carries GDAL and is therefore opt-in:
#
#     make build-eo
#
# or set this and rebuild. Without it, fires report an estimated area from
# thermal pixels and say so.
AMONHEN_INSTALL_EO=false
# Scene cloud cover to accept. Generous: cloud is scored per-pixel from the
# scene classification anyway, so a 30%-cloud scene is often clear over the fire.
AMONHEN_SENTINEL2_MAX_CLOUD_PCT=40.0
# Switches for the two products, for an operator who has installed the extra but
# wants the imagery reads off.
AMONHEN_BURN_SCAR_ENABLED=true
AMONHEN_FUEL_MOISTURE_ENABLED=true
# Imagery reads are the slowest part of a rebuild; this bounds how many run at once.
AMONHEN_EO_MAX_CONCURRENT_READS=4

# --- Area of interest ------------------------------------------------------
AMONHEN_AREA_OF_INTEREST_NAME=Greece
# west,south,east,north in EPSG:4326
AMONHEN_AREA_OF_INTEREST_BBOX=[19.3,34.7,29.7,41.8]
AMONHEN_TIMEZONE=Europe/Athens

# --- Ingest ----------------------------------------------------------------
AMONHEN_INGEST_ENABLED=true
AMONHEN_FIRMS_POLL_MINUTES=15

# --- Area of interest filtering --------------------------------------------
# FIRMS only accepts a bounding box, and every rectangle around Greece also
# contains western Turkey, Albania, North Macedonia and southern Bulgaria — in
# live data that was ~92% of all detections. Detections are therefore clipped
# against an actual country polygon (data/boundaries/greece.geojson).
AMONHEN_RESTRICT_TO_BOUNDARY=true
AMONHEN_BOUNDARY_NAME=greece
# Fires do not respect borders: detections this far outside the polygon are
# still kept. 0 = strict. Past ~20 km you start re-admitting unrelated fires.
AMONHEN_BOUNDARY_MARGIN_KM=5.0

# --- Incident clustering ---------------------------------------------------
# Detections within 3 km AND 30 h of each other are treated as the same fire.
# 30 h is measured, not guessed: gaps between consecutive detections of the same
# burning ground cluster at ~24 h (the daily polar-orbit revisit). The old 12 h
# window split 10.5% of them, fragmenting one fire into one incident per day.
AMONHEN_CLUSTER_EPS_KM=3.0
AMONHEN_CLUSTER_EPS_HOURS=30.0
AMONHEN_CLUSTER_MIN_SAMPLES=2

# --- Database (only needed with the `persistence` compose profile) ----------
AMONHEN_POSTGRES_HOST=localhost
AMONHEN_POSTGRES_PORT=5432
AMONHEN_POSTGRES_USER=amonhen
AMONHEN_POSTGRES_PASSWORD=amonhen
AMONHEN_POSTGRES_DB=amonhen
