{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
  { "source": "/api/v1/(.*)", "destination": "https://amon-hen-api.fly.dev/api/v1/$1" },
  { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
